# ============ 数据库（本机 MySQL 8） ============
DATABASE_URL=mysql+aiomysql://stellar:stellar123@127.0.0.1:3306/stellar_sense?charset=utf8mb4

# ============ JWT ============
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# ============ LLM（OpenAI 兼容；默认 DeepSeek） ============
# LLM_API_KEY 留空时节点伴学明确展示固定摘要
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# 可选：本地知识星图 JSON 索引的绝对路径，不填写则提供标注的模型讲解
RAG_INDEX_PATH=

# ============ 其他 ============
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
