# ============ 数据库（本机 MySQL 8） ============
DATABASE_URL=mysql+aiomysql://stellar:stellar123@127.0.0.1:3306/stellar_sense?charset=utf8mb4

# ============ JWT ============
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# ============ LLM（OpenAI 兼容；默认 DeepSeek） ============
# LLM_API_KEY 留空时自动使用内置 Mock 回复，链路仍可跑通
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ============ 其他 ============
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
